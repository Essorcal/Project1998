<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <ProjectReference Include="..\Protocol.Tk495\Protocol.Tk495.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The #27 seam lets a test BUILD a Session; this lets one ARRANGE the state a handler reads. Nearly
         everything a damage test has to set up first — a Harden Body ward (ItemSetStatus), the sleep-family
         amplifier (ArmDamageAmp), the sanctuary deduction (ApplySanctuaryDeduction) — is internal, and two
         of the five damage intakes are internal themselves. Widening any of them to public to suit a test
         would be the wrong trade: they are not API, and public is a promise to every other caller. -->
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- Server GC + concurrent (background) gen2. The default for a console app is WORKSTATION GC, which
         collects on the allocating thread: a gen2 there stops the world tick mid-heartbeat. Server GC gives
         each core its own heap and dedicated collection threads, and Concurrent keeps gen2 mostly in the
         background instead of as one blocking pause. The tick allocates several lists plus a HashSet per
         active map per 600ms, so this is squarely the allocation profile server GC is for.
         Costs more RSS (one heap per core). Override on a memory-tight host without a rebuild:
         DOTNET_gcServer=0. The slow-tick watchdog prints a per-tick gc figure to tell if it mattered. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

</Project>
