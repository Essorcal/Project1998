# ---- .NET build output ----
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo

# ---- Game data ----
# data/ is its OWN git repo (submodule, local remote for now — see data/.gitignore), tracked separately
# from this logic-only server repo. Content: data/rtk-data/ (regenerable via the re/ tools), maps, SObj.tbl.
# Its own .gitignore keeps live runtime state (char store, nexus.db) out of that history too.

*.log
server_live.err
server-err.log

# ---- RE tooling byproducts ----
re/__pycache__/
re/probe_log.txt
re/probe_log_533.txt
re/nametag_log.txt
scratch_*.html

# ---- client exe backups made by re/patch_*.py before an on-disk binary patch (never commit a full game exe) ----
re/*.exe
re/*.exe.bak
re/*.prenametagpatch.bak
re/patches/backups/
re/patches/**/__pycache__/

# ---- RE-tool byproducts extracted from the client PAK (regenerable via re/pak_extract.py) ----
re/monster.epf
re/monster.tbl
re/monster.pal
re/monster0.pal
re/item.tbl
re/Item.epf
re/Item.pal
re/Item.tbl
re/items_*.png
re/snd/
re/sound_log.txt
re/monsfrm.tbl
re/str_eng.res
re/nexustk_dat_list.txt
re/interdat_list.txt
# Compiled/converted client maps (game data; e.g. from re/map2cmp.py):
re/*.cmp
# Extracted from the RTK reference server / Nexus Atlas (regenerable via the tools in re/; output now lands
# in data/rtk-data/, covered by the blanket data/ rule above):
re/monster-matcher/atlas_img/
re/monster-matcher/atlas_ref.json
re/monster-matcher/cdx_monsternpc.json
re/monster-matcher/*.png

# ---- Third-party client shim (8 MB of prebuilt binaries; re-downloadable) ----
re/cnc-ddraw/

# ---- Reference server source (unkmc/RTK-Server, ~190MB; cloned for protocol reference only) ----
RTK-Server/

# runtime redirect dir written by the client
client-5.33-redirect/

re/monster-matcher/server.log
