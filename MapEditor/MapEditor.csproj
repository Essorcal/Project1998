<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net8.0-windows + WinExe: the editor is a windowed app (WebView2 shell, no console).
         EnableWindowsTargeting lets a Linux box BUILD it (it never runs there). Server CI does not:
         it builds Project1998.Server.slnf, which leaves this project out. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
