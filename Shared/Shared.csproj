<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Generate the XML so CS1574/CS0419 dangling-cref warnings are enforced by TreatWarningsAsErrors.
         CS1591 and CS1573 are pervasive completeness warnings, not the reference validation this enables. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.Core\Shared.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!-- The game server mutates Shared's internal world-Mob state; Tests also resets process-wide test hooks. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Server" />
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

</Project>
