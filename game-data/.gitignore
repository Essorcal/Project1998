# ---- Live runtime state (per-player saves + shared SQLite DB) — NOT content, stays untracked ----
# Character store: one JSON file per player (Server/Net.cs CharacterStore), churns on every login/save.
chars/
# Shared SQLite DB (Shared/Db.cs): accounts, sessions, board posts. WAL mode, hence the sidecar files.
nexus.db
nexus.db-wal
nexus.db-shm
nexus.db-journal
# Server stdout capture — runtime artifact, not content.
server.log
*.log

# ---- Rotated stdout captures (server.log.1, .2, ...) — the bare *.log rule above misses these ----
server.log.*

# ---- Editor/tool backups made before a bulk CSV rewrite. The rewritten file is the content; the
# pre-image is scratch. Includes the one-off *.pre-<thing>-restore snapshots. ----
*.bak
*.bak[0-9]
*.pre-*
